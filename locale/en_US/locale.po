msgid "plugins.generic.backlinkTracker.displayName"
msgstr "Backlink Tracker by OJSpro"

msgid "plugins.generic.backlinkTracker.description"
msgstr "Displays external references (backlinks) to articles from uploaded CSV data (SEMrush, Ahrefs, Google Search Console). Shows referring domains, anchor text, and reference targets on article pages."

msgid "plugins.generic.backlinkTracker.settings.description"
msgstr "Backlink Tracker Settings"

msgid "plugins.generic.backlinkTracker.settings.help"
msgstr "Configure backlink tracking by uploading CSV data and managing URL redirect mappings."

msgid "plugins.generic.backlinkTracker.settings.gscSettings"
msgstr "Google Search Console Settings"

msgid "plugins.generic.backlinkTracker.settings.journalSite"
msgstr "Journal Site (OJS)"

msgid "plugins.generic.backlinkTracker.settings.wordpressSite"
msgstr "Repository Site (WordPress)"

msgid "plugins.generic.backlinkTracker.settings.gscJournalUrl"
msgstr "Journal Site URL"

msgid "plugins.generic.backlinkTracker.settings.gscWordpressUrl"
msgstr "WordPress Site URL"

msgid "plugins.generic.backlinkTracker.settings.gscCredentials"
msgstr "Google Service Account JSON"

msgid "plugins.generic.backlinkTracker.settings.gscCredentialsHelp"
msgstr "Paste the entire contents of your Google Service Account JSON file here. This file is downloaded from Google Cloud Console when you create service account credentials."

msgid "plugins.generic.backlinkTracker.settings.otherAPIs"
msgstr "Other API Settings"

msgid "plugins.generic.backlinkTracker.settings.bingApiKey"
msgstr "Bing Webmaster API Key (Optional)"

msgid "plugins.generic.backlinkTracker.settings.matchingSettings"
msgstr "Article Matching Settings"

msgid "plugins.generic.backlinkTracker.settings.repoGalleyLabel"
msgstr "Repository Galley Label"

msgid "plugins.generic.backlinkTracker.settings.repoGalleyLabelHelp"
msgstr "Enter the label used for repository/full-text galleys (e.g., REPO, Repository, Full Text). This helps the plugin match backlinks to both abstract and full-text URLs."

msgid "plugins.generic.backlinkTracker.settings.blockedDomains"
msgstr "Domain Filtering"

msgid "plugins.generic.backlinkTracker.settings.blockedDomainsHelp"
msgstr "Enter domains to exclude from backlink display (one per line). Example: spamsite.com"

msgid "plugins.generic.backlinkTracker.settings.redirectMapping"
msgstr "URL Redirect Mapping"

msgid "plugins.generic.backlinkTracker.settings.redirectMappingHelp"
msgstr "Upload a CSV file mapping old URLs to new URLs after domain migration. Format: old_url,new_url"

msgid "plugins.generic.backlinkTracker.settings.useSiteWideData"
msgstr "Use site-wide data (shared across all journals)"

msgid "plugins.generic.backlinkTracker.settings.useSiteWideDataHelp"
msgstr "Enable this to share backlinks and redirect mappings across all journals. When enabled, uploading data to any journal will update it for all journals."

